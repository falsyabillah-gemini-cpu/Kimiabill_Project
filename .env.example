# === LLM Providers (isi sesuai provider yang dipilih di config/agents.yaml) ===
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# === Real Footage API (opsional, gratis di https://www.pexels.com/api/ — sangat disarankan) ===
PEXELS_API_KEY=

# === Jadwal Otomasi 24/7 (khusus mode VPS/Docker) ===
# Format 24 jam WIB (Asia/Jakarta), misal 08:00 atau 08:00,18:00
SCHEDULE_TIMES_WIB=08:00
AUTO_UPLOAD_GDRIVE=true
GDRIVE_ROOT_FOLDER=Kimiabill_Studio
# URL Web App dari Google Apps Script (deploy/gdrive_apps_script.gs) untuk auto-upload Drive + email notifikasi
GDRIVE_WEBHOOK_URL=
GDRIVE_WEBHOOK_TOKEN=
NOTIFY_EMAIL_TO=researchfalsyabillah@gmail.com

# === AGENT 7: Auto-Publish Media Sosial ===
# Mode aman: "dry_run" (paket thumbnail+caption saja) | "draft" (upload draft/unlisted) | "public" (langsung tayang)
PUBLISH_MODE=draft

# 1. YouTube Shorts (YouTube Data API v3 OAuth2)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 2. Instagram Reels (Meta Graph API — butuh akun IG Creator/Business)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
# URL publik sementara file video (mis. Cloudflare R2 / S3 / public host) untuk di-fetch Meta Graph API
PUBLIC_MEDIA_BASE_URL=

# 3. TikTok (TikTok Content Posting API v2)
TIKTOK_ACCESS_TOKEN=

# 4. Opsional: Bridge 1-API (Upload-Post / Ayrshare / Late) jika ingin 1 token untuk semua platform
SOCIAL_BRIDGE_WEBHOOK_URL=
SOCIAL_BRIDGE_API_KEY=
